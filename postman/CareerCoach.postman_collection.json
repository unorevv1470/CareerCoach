{
 "info":{"name":"CareerCoach API","description":"End-to-end API tests. Run in order. Registration and login save the JWT automatically.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
 "variable":[{"key":"baseUrl","value":"http://localhost:5000"},{"key":"token","value":""},{"key":"adminToken","value":""},{"key":"email","value":"student{{$timestamp}}@example.com"},{"key":"password","value":"CareerCoach123"}],
 "item":[
  {"name":"1. Health check","request":{"method":"GET","url":"{{baseUrl}}/api/health"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('API is healthy',()=>pm.response.to.have.status(200));","pm.test('Status is ok',()=>pm.expect(pm.response.json().status).to.eql('ok')); "]}}]},
  {"name":"2. Register user","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},"url":"{{baseUrl}}/api/auth/register"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Registered (201)',()=>pm.response.to.have.status(201));","const d=pm.response.json(); pm.collectionVariables.set('token',d.token);","pm.test('JWT returned',()=>pm.expect(d.token).to.be.a('string')); "]}}]},
  {"name":"3. Login user","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},"url":"{{baseUrl}}/api/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login successful',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('token',pm.response.json().token);"]}}]},
  {"name":"4. Get current user","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/auth/me"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Authenticated user returned',()=>pm.response.to.have.status(200));"]}}]},
  {"name":"5. Save profile","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"education\": [\"B.Tech Computer Science, 2025-2029\"],\n  \"skills\": [\"Figma\", \"Communication\", \"Problem Solving\"],\n  \"experience\": [\"Student volunteer - organized university events\"],\n  \"targetRole\": \"UI/UX Designer\"\n}"},"url":"{{baseUrl}}/api/profile"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Profile saved',()=>pm.response.to.have.status(200));"]}}]},
  {"name":"6. Get profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/profile"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Profile retrieved',()=>pm.response.to.have.status(200));","pm.test('Skills exist',()=>pm.expect(pm.response.json().profile.skills).to.include('Figma')); "]}}]},
  {"name":"7. Generate resume","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/generations/resume"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Resume generated',()=>pm.response.to.have.status(201));","pm.test('Summary returned',()=>pm.expect(pm.response.json().generation.result.summary).to.be.a('string')); "]}}]},
  {"name":"8. Generate interview questions","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"role\": \"Junior UI/UX Designer\"\n}"},"url":"{{baseUrl}}/api/generations/interview"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Questions generated',()=>pm.response.to.have.status(201));","pm.test('Questions array returned',()=>pm.expect(pm.response.json().generation.result.questions).to.be.an('array')); "]}}]},
  {"name":"9. Generation history","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/generations/history?page=1&limit=10"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('History retrieved',()=>pm.response.to.have.status(200));","pm.test('History contains saved records',()=>pm.expect(pm.response.json().total).to.be.above(0));"]}}]},
  {"name":"10. Admin usage report (set adminToken first)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/api/admin/usage"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Admin report returned',()=>pm.response.to.have.status(200));","pm.test('Aggregation totals returned',()=>pm.expect(pm.response.json()).to.have.property('totalGenerations')); "]}}]}
 ]
}
